# Example environment configuration for EASM
# Copy this file to .env and update with your values

# Environment Configuration
# Set to 'development' or 'production'
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://easm:changeme@localhost:5432/easm

# Security - API keys are scoped as key:company_uuid:role[:allow]
# Example role values: admin, operator, analyst, viewer
API_KEYS=dev-key-change-me-in-production:00000000-0000-0000-0000-000000000000:admin
# Optional: allow unauthenticated access for local development only
ALLOW_ANON=false
# Optional: restrict API key usage to specific IPs/CIDRs (comma-separated)
# API_KEY_IP_ALLOWLIST=203.0.113.10,198.51.100.0/24
# Optional: break-glass token for revealing secrets via the settings API
# BREAK_GLASS_TOKEN=changeme_break_glass_token

# Authentication & SSO
# Generate a random 32+ byte string for AUTH_SECRET. Must be at least 64 chars if using Cookie Store!
AUTH_SECRET=changeme_super_secret_session_key_must_be_at_least_64_bytes_long_for_security_reasons_so_here_is_a_very_long_string_!!
AUTH_SESSION_EXPIRY_SECONDS=86400

# Google OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_ALLOWED_DOMAINS=

# Keycloak (OIDC)
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_DISCOVERY_URL=
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak
KEYCLOAK_REALM=

# External API Keys (all optional)
#
# Discovery queries 19 passive OSINT corpora. Eight of them need no key at all
# (crt.sh, AlienVault OTX, HackerTarget, RapidDNS, AnubisDB, urlscan.io, the
# Wayback Machine, Columbus, Digitorus), so discovery is useful out of the box.
# A source whose key is missing reports "skipped" and the run continues.
# CERTSPOTTER_API_TOKEN=your-certspotter-token
# VIRUSTOTAL_API_KEY=your-virustotal-key
# SHODAN_API_KEY=your-shodan-key
# SECURITYTRAILS_API_KEY=your-securitytrails-key
# CENSYS_API_KEY=your-censys-personal-access-token
# CENSYS_ORG_ID=your-censys-organization-id
# CHAOS_API_KEY=your-projectdiscovery-chaos-key
# LEAKIX_API_KEY=your-leakix-key
# FULLHUNT_API_KEY=your-fullhunt-key
# BINARYEDGE_API_KEY=your-binaryedge-key
# NETLAS_API_KEY=your-netlas-key
# urlscan.io and OTX answer anonymously; a key only raises the rate limit.
# URLSCAN_API_KEY=your-urlscan-api-key
# OTX_API_KEY=your-otx-api-key
# CLEARBIT_API_KEY=your-clearbit-api-key
# OPENCORPORATES_API_TOKEN=your-opencorporates-token
# NVD (NIST) CVE lookup - optional key raises the rate limit from 5 to 50
# requests per 30s. Request one at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=your-nvd-api-key

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:80,http://127.0.0.1:80

# Application Settings
# LOG_LEVEL controls logging verbosity for both frontend and backend
# Valid values: TRACE, DEBUG, INFO, WARN, ERROR
# Note: Do NOT set RUST_LOG - it will be automatically configured from LOG_LEVEL
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Performance Tuning
HTTP_TIMEOUT_SECONDS=8.0
TLS_TIMEOUT_SECONDS=4.0
DNS_CONCURRENCY=256
RDNS_CONCURRENCY=256
MAX_CONCURRENT_SCANS=5
MAX_ACTIVE_SCANS_PER_USER=2
MAX_ACTIVE_DISCOVERY_PER_USER=1
BLOCK_INTERNAL_IP_SCANS=true
# Allow internal scans in production only when explicitly enabled
ALLOW_INTERNAL_SCANS=false
# Optional scan target allowlists (comma-separated)
# SCAN_ALLOWLIST_CIDRS=203.0.113.0/24,198.51.100.10/32
# SCAN_ALLOWLIST_DOMAINS=example.com,example.org

# Evidence Storage
MAX_EVIDENCE_BYTES=52428800
EVIDENCE_ALLOWED_TYPES=image/png,image/jpeg,text/plain,application/pdf

# Discovery Settings  
MAX_CIDR_HOSTS=4096
MAX_DISCOVERY_DEPTH=3
SUBDOMAIN_ENUM_TIMEOUT=120.0

# OSINT Integration Toggles
ENABLE_WAYBACK=true                    # ✅ Wayback Machine CDX index
ENABLE_URLSCAN=true                    # ✅ urlscan.io scan index
ENABLE_OTX=true                        # ✅ AlienVault OTX passive DNS
ENABLE_DNS_RECORD_EXPANSION=true       # ⚠️  NOT CHECKED - Always enabled (planned feature)
ENABLE_WEB_CRAWL=true                  # ❌ NOT IMPLEMENTED - Web crawler for link extraction
ENABLE_CLOUD_STORAGE_DISCOVERY=true    # ❌ NOT IMPLEMENTED - S3/Azure/GCS bucket discovery
ENABLE_WIKIDATA=true                   # ❌ NOT IMPLEMENTED - Wikidata entity lookups
ENABLE_OPENCORPORATES=false            # ❌ NOT IMPLEMENTED - OpenCorporates integration

# Passive OSINT Fan-out
# Sources are queried concurrently, so enumeration costs the slowest source
# rather than the sum of all of them.
OSINT_SOURCE_CONCURRENCY=12            # Sources queried at once (1-64)
OSINT_SOURCE_TIMEOUT_SECONDS=25.0      # Wall-clock budget per source
OSINT_MAX_RESULTS_PER_SOURCE=5000      # Cap on hostnames taken from one source

# Active DNS Discovery
# Reaches names no passive corpus ever recorded. Wildcard detection runs first
# and gates all of it: a catch-all zone answers every query, so without a
# baseline a brute force would "confirm" the whole wordlist.
ENABLE_DNS_BRUTEFORCE=true             # Resolve a wordlist of common labels
ENABLE_DNS_PERMUTATIONS=true           # Mutate known-good names (api -> api-dev, api2)
ENABLE_NSEC_WALK=true                  # Walk NSEC chains of DNSSEC-signed zones
ENABLE_SRV_PROBE=true                  # Query well-known _service._proto SRV labels
DNS_BRUTEFORCE_MAX_WORDS=2000          # Labels taken from the list, best-first
DNS_PERMUTATION_MAX_CANDIDATES=5000    # Ceiling on generated permutations
DNS_PERMUTATION_MAX_SEEDS=50           # Known-good names used as permutation seeds
ACTIVE_DNS_CONCURRENCY=50              # Concurrent in-flight resolutions
# Point at a bigger list (e.g. SecLists) to replace the built-in one.
# DNS_BRUTEFORCE_WORDLIST_PATH=/opt/wordlists/subdomains-top1million.txt

# Infrastructure Attribution
# Turns a list of names into a list of owned address space. Uses Team Cymru
# (over DNS) and RIPEstat (over HTTP) — neither needs a key.
ENABLE_ASN_DISCOVERY=true              # Origin AS and announced netblocks
ENABLE_RDAP_LOOKUP=true                # Registry org and abuse contacts
ENABLE_SAAS_TENANT_DISCOVERY=true      # SaaS vendors proven by apex TXT tokens
ENABLE_CNAME_CHAIN_ANALYSIS=true       # Follow CNAME chains (takeover surface)
ASN_MAX_PREFIXES=64                    # Announced prefixes recorded per ASN
REVERSE_DNS_SWEEP_MAX_HOSTS=256        # Addresses swept per netblock (0 disables)

# Recursive Discovery Limits (to reduce false-positives)
# Maximum total assets to discover in a single discovery run
MAX_ASSETS_PER_DISCOVERY=5000
# Minimum confidence score (0.0-1.0) required to follow a pivot relationship
# Higher values reduce false-positives but may miss some legitimate assets
MIN_PIVOT_CONFIDENCE=0.5
# Maximum number of organizations to pivot from per domain (prevents explosion)
MAX_ORGS_PER_DOMAIN=3
# Maximum number of domains to pivot from per organization (prevents explosion)
MAX_DOMAINS_PER_ORG=20

# Search
REINDEX_MIN_INTERVAL_SECONDS=300
